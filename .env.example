# Copy to .env and fill in. Every value below is a placeholder.
# Tests and `npm run demo` need NONE of these (they use in-memory fakes).

# --- Brand / locale (no brand strings are hardcoded in code) ---
BRAND_NAME=Acme Wellness Studio
APP_TIMEZONE=America/Los_Angeles
STAFF_HOST=crm.example.com
BOOKING_HOST=book.example.com
MARKETING_HOSTS=example.com,www.example.com
PUBLIC_URL=https://crm.example.com

# --- Database ---
DATABASE_URL=postgresql://studio_os:<password>@localhost:5432/studio_os

# --- Auth ---
NEXTAUTH_SECRET=your-random-32-byte-secret-here
CRON_SECRET=your-cron-secret-here
SYNC_SECRET=your-sync-secret-here
INTERNAL_INGEST_TOKEN=your-ingest-token-here

# --- Payments (dual rail; Stripe stays dark until the flag is true) ---
NMI_SECURITY_KEY=your-nmi-key-here
STRIPE_GATEWAY_ENABLED=false
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret-here

# --- Messaging ---
SIGNALWIRE_SIGNING_KEY=your-signalwire-signing-key-here
EMAIL_API_KEY=your-email-api-key-here
EMAIL_WEBHOOK_SECRET=your-svix-format-secret-here

# --- Workflow kill switch (default OFF: steps are recorded, not sent) ---
WORKFLOW_DISPATCH_ENABLED=false

# --- Ops alerting (ops/cron-with-alert.sh, ops/deploy.sh) ---
CRON_ALERT_TO=ops@example.com
DEPLOY_NOTIFY_TO=ops@example.com
